{
	"name": "fractal",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"generate-pwa-assets": "pwa-assets-generator",
		"preview": "vite preview",
		"test": "node --test",
		"format": "prettier --write \"src/**/*.{html,css,js,json}\" && prettier --plugin prettier-plugin-glsl --parser glsl-parser --write \"src/**/*.frag\"",
		"format:check": "prettier --check \"src/**/*.{html,css,js,json}\" && prettier --plugin prettier-plugin-glsl --parser glsl-parser --check \"src/**/*.frag\"",
		"lint": "npm run format"
	},
	"devDependencies": {
		"@vite-pwa/assets-generator": "^1.0.2",
		"prettier": "3.8.3",
		"prettier-plugin-glsl": "^0.3.0",
		"vite": "^8.0.13",
		"vite-plugin-glsl": "^1.6.0",
		"vite-plugin-pwa": "^1.3.0"
	},
	"dependencies": {
		"@tweenjs/tween.js": "^25.0.0",
		"gmp-wasm": "^1.3.2",
		"shaderpad": "^1.0.0-beta.85",
		"tinykeys": "^3.0.0"
	}
}
